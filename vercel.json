{
  "version": 2,
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "source": "/orders",
      "destination": "/orders.html"
    },
    {
      "source": "/plant",
      "destination": "/plant.html"
    },
    {
      "source": "/((?!admin|dashboard|orders|plant).*)",
      "destination": "/index.html"
    }
  ]
}