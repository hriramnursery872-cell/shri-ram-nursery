{
  "version": 2,
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/admin",
      "destination": "/admin.html"
    },
    {
      "src": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "src": "/orders",
      "destination": "/orders.html"
    },
    {
      "src": "/plant",
      "destination": "/plant.html"
    },
    {
      "src": "/(.*)",
      "destination": "/index.html"
    }
  ]
}