{
  "version": 2,
  "builds": [
    {
      "src": "package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "dist"
      }
    }
  ],
  "routes": [
    {
      "handle": "filesystem"
    },
    {
      "src": "/admin",
      "destination": "/admin.html"
    },
    {
      "src": "/dashboard",
      "destination": "/dashboard.html"
    },
    {
      "src": "/orders",
      "destination": "/orders.html"
    },
    {
      "src": "/plant",
      "destination": "/plant.html"
    },
    {
      "src": "/(.*)",
      "destination": "/index.html"
    }
  ]
}