// ------------------------------------------------------------
// NORMALIZE PLANT DATA
// ------------------------------------------------------------

function normalizePlant(plant) {
  return {
    id: String(plant.id || crypto.randomUUID()),
    name: String(plant.name || "Unnamed Plant"),
    category: String(plant.category || "Other"),
    category_hi: String(plant.category_hi || ""),
    variety: String(plant.variety || ""),
    image: String(plant.image || ""),
    guide_link: String(plant.guide_link || ""),
    care_tips: String(plant.care_tips || "इस पौधे की देखभाल के लिए नर्सरी से जानकारी लें."),

    // कीमत जानबूझकर नहीं रखी गई।
    // वेबसाइट पर कोई Price field नहीं दिखाना है।

    // केवल Stock indicator.
    stock: true,

    // Social interaction data.
    likes: Number(plant.likes || 0),
    shares: Number(plant.shares || 0)
  };
}


// ------------------------------------------------------------
// LOAD PLANTS
// ------------------------------------------------------------

export function getPlants() {
  try {
    const saved = localStorage.getItem(STORAGE_KEY);

    if (!saved) {
      return DEFAULT_PLANTS.map(normalizePlant);
    }

    const parsed = JSON.parse(saved);

    if (!Array.isArray(parsed)) {
      return DEFAULT_PLANTS.map(normalizePlant);
    }

    return parsed.map(normalizePlant);

  } catch (error) {
    console.error("Shri Ram Nursery: Unable to load plants.", error);
    return DEFAULT_PLANTS.map(normalizePlant);
  }
}


// ------------------------------------------------------------
// SAVE PLANTS
// ------------------------------------------------------------

export function savePlants(plants) {
  try {
    const cleanPlants = Array.isArray(plants)
      ? plants.map(normalizePlant)
      : [];

    localStorage.setItem(
      STORAGE_KEY,
      JSON.stringify(cleanPlants)
    );

    return true;

  } catch (error) {
    console.error("Shri Ram Nursery: Unable to save plants.", error);
    return false;
  }
}


// ------------------------------------------------------------
// ADD PLANT
// ------------------------------------------------------------

export function addPlant(plant) {
  const plants = getPlants();

  const newPlant = normalizePlant({
    ...plant,
    id: plant?.id || `plant_${Date.now()}`
  });

  plants.push(newPlant);
  savePlants(plants);

  return newPlant;
}


// ------------------------------------------------------------
// DELETE PLANT
// ------------------------------------------------------------

