  const plants = getPlants();

  const updated = plants.filter(
    plant => plant.id !== String(id)
  );

  savePlants(updated);

  return updated;
}


// ------------------------------------------------------------
// UPDATE PLANT
// ------------------------------------------------------------

export function updatePlant(id, changes = {}) {
  const plants = getPlants();

  const index = plants.findIndex(
    plant => plant.id === String(id)
  );

  if (index === -1) {
    return null;
  }

  plants[index] = normalizePlant({
    ...plants[index],
    ...changes,
    id: plants[index].id
  });

  savePlants(plants);

  return plants[index];
}


// ------------------------------------------------------------
// GET SINGLE PLANT
// ------------------------------------------------------------

export function getPlantById(id) {
  const plants = getPlants();

  return plants.find(
    plant => plant.id === String(id)
  ) || null;
}


// ------------------------------------------------------------
// CATEGORY FILTER
// ------------------------------------------------------------

export function getPlantsByCategory(category) {
  const plants = getPlants();

  if (!category || category === "All") {
    return plants;
  }

  return plants.filter(
    plant =>
      plant.category.toLowerCase() ===
      String(category).toLowerCase()
  );
}


// ------------------------------------------------------------
// SEARCH
// ------------------------------------------------------------

export function searchPlants(query) {
  const plants = getPlants();

  const text = String(query || "")
    .trim()
    .toLowerCase();

  if (!text) {
    return plants;
  }

  return plants.filter(plant => {
    return (
      plant.name.toLowerCase().includes(text) ||
      plant.category.toLowerCase().includes(text) ||
      plant.category_hi.toLowerCase().includes(text) ||
      plant.variety.toLowerCase().includes(text)
    );
  });
}


// ------------------------------------------------------------
// LIKE PLANT
// ------------------------------------------------------------

export function likePlant(id) {
  const plants = getPlants();

  const plant = plants.find(
    item => item.id === String(id)
  );

  if (!plant) {
    return null;
  }

  plant.likes = Number(plant.likes || 0) + 1;

  savePlants(plants);

  return plant.likes;
}


// ------------------------------------------------------------
// SHARE PLANT
// ------------------------------------------------------------

export async function sharePlant(plant) {
  if (!plant) {
    return false;
  }

  const shareData = {
    title: plant.name,
    text:
      `${plant.name}\n\n` +
      `${plant.variety ? plant.variety + "\n" : ""}` +
      `🌿 Shri Ram Nursery, Bhuna`
  };

  try {
    if (navigator.share) {
      await navigator.share(shareData);

      const plants = getPlants();

      const current = plants.find(
        item => item.id === String(plant.id)
      );

      if (current) {
        current.shares = Number(current.shares || 0) + 1;
        savePlants(plants);
      }

      return true;
    }

    // Fallback: copy information to clipboard
    const fallbackText =
      `${plant.name}\n` +
      `${plant.variety || ""}\n` +
      `Shri Ram Nursery, Bhuna`;

    await navigator.clipboard.writeText(fallbackText);

    return true;

  } catch (error) {
    console.log("Share cancelled or unavailable.", error);
    return false;
  }
}


// ------------------------------------------------------------
// RESET CATALOG
// ------------------------------------------------------------

export function resetPlants() {
  const freshCatalog = DEFAULT_PLANTS.map(normalizePlant);

  localStorage.setItem(
    STORAGE_KEY,
    JSON.stringify(freshCatalog)
  );

  return freshCatalog;
}


// ------------------------------------------------------------
// EXPORT MASTER DATA
// ------------------------------------------------------------

export { DEFAULT_PLANTS };