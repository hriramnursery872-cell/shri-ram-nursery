# मुख्य रन कमांड जो API सर्वर को पोर्ट 8080 के साथ शुरू करेगी
run = "PORT=8080 node artifacts/api-server/dist/index.mjs"
modules = ["nodejs-20"]

[[ports]]
localPort = 8080
externalPort = 8080

[deployment]
run = ["PORT=8080", "node", "artifacts/api-server/dist/index.mjs"]

[deployment.healthCheck]
path = "/"
port = 8080
interval = 5
timeout = 2

[nix]
packages = ["psmisc"]
